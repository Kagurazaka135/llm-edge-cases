elRear'),\n    wheelFront: $('wheelFront'),\n    crankNear: $('crankNear'),\n    crankFar: $('crankFar'),\n    thighNear: $('thighNear'),\n    shinNear: $('shinNear'),\n    thighFar: $('thighFar'),\n    shinFar: $('shinFar'),\n    footNear: $('footNear'),\n    footFar: $('footFar'),\n    bikeTilt: $('bikeTilt'),\n    roadLine: $('roadLine'),\n    treeLayer: $('treeLayer'),\n    hillLayer: $('hillLayer'),\n    hillFarLayer: $('hillFarLayer'),\n    speedBar: $('speedBar'),\n    speedText: $('speedText')\n  };\n  ...\n})();\n```\n\n好。\n\n现在写更新和渲染。\n\n让我写 `solveLeg`。\n\n```js\nfunction solveLeg(hip, foot, l1, l2) {\n  let dx = foot.x - hip.x;\n  let dy = foot.y - hip.y;\n  let d = Math.sqrt(dx * dx + dy * dy);\n  const maxD = l1 + l2 - 0.5;\n  if (d > maxD) {\n    const s = maxD / d;\n    dx *= s; dy *= s; d = maxD;\n  }\n  if (d < 0.001) d = 0.001;\n  const a = (l1 * l1 - l2 * l2 + d * d) / (2 * d);\n  const h = Math.sqrt(Math.max(0, l1 * l1 - a * a));\n  const ux = dx / d, uy = dy / d;\n  return {\n    x: hip.x + a * ux + h * uy,\n    y: hip.y + a * uy - h * ux\n  };\n}\n```\n\n✓\n\n好。\n\n现在写渲染函数。\n\n让我把它写出来。\n\n```js\nfunction render() {\n  const rad = S.crank * Math.PI / 180;\n  const bbX = -60, bbY = -35, cr = 18;\n\n  const pNear = { x: bbX - cr * Math.sin(rad), y: bbY + cr * Math.cos(rad) };\n  const pFar  = { x: bbX + cr * Math.sin(rad), y: bbY - cr * Math.cos(rad) };\n\n  const hipNear = { x: -78, y: -100 };\n  const hipFar  = { x: -83, y: -97 };\n\n  const kNear = solveLeg(hipNear, pNear, 42, 44);\n  const kFar  = solveLeg(hipFar, pFar, 42, 44);\n\n  setLine(D.thighNear, hipNear.x, hipNear.y, kNear.x, kNear.y);\n  setLine(D.shinNear, kNear.x, kNear.y, pNear.x, pNear.y);\n  setLine(D.thighFar, hipFar.x, hipFar.y, kFar.x, kFar.y);\n  setLine(D.shinFar, kFar.x, kFar.y, pFar.x, pFar.y);\n\n  setCircle(D.footNear, pNear.x, pNear.y);\n  setCircle(D.footFar, pFar.x, pFar.y);\n\n  D.wheelRear.setAttribute('transform', 'rotate(' + S.wheel + ' -110 -40)');\n  D.wheelFront.setAttribute('transform', 'rotate(' + S.wheel + ' 40 -40)');\n  D.crankNear.setAttribute('transform', 'rotate(' + S.crank + ' -60 -35)');\n  D.crankFar.setAttribute('transform', 'rotate(' + (S.crank + 180) + ' -60 -35)');\n  D.bikeTilt.setAttribute('transform', 'rotate(' + (S.tilt * 6) + ' -35 0)');\n\n  D.roadLine.setAttribute('stroke-dashoffset', S.roadScroll % 120);\n  D.treeLayer.setAttribute('transform', 'translate(' + (-(S.treeScroll % 300)) + ',0)');\n  D.hillLayer.setAttribute('transform', 'translate(' + (-(S.hillScroll % 450)) + ',0)');\n  D.hillFarLayer.setAttribute('transform', 'translate(' + (-(S.hillFarScroll % 600)) + ',0)');\n\n  D.speedBar.style.width = (S.speed * 100).toFixed(1) + '%';\n  D.speedText.textContent = Math.round(S.speed * 45) + ' km/h';\n}\n```\n\n好。\n\n等等，`S.roadScroll % 120` 是正的。✓\n\n现在，`stroke-dashoffset` 用正数 → 虚线向左移动。✓\n\n好。\n\n现在写事件绑定。\n\n```js\nfunction bindHold(el, key) {\n  const down = (e) => {\n    e.preventDefault();\n    if (el.setPointerCapture && e.pointerId != null) {\n      try { el.setPointerCapture(e.pointerId); } catch (_) {}\n    }\n    S[key] = true;\n    el.classList.add('active');\n  };\n  const up = () => {\n    S[key] = false;\n    el.classList.remove('active');\n  };\n  el.addEventListener('pointerdown', down);\n  el.addEventListener('pointerup', up);\n  el.addEventListener('pointercancel', up);\n  el.addEventListener('lostpointercapture', up);\n}\n```\n\n好。\n\n键盘：\n\n```js\nconst KEYMAP = {\n  ArrowUp: 'accel', KeyW: 'accel',\n  ArrowDown: 'brake', KeyS: 'brake',\n  ArrowLeft: 'left', KeyA: 'left',\n  ArrowRight: 'right', KeyD: 'right'\n};\n```\n\n好。\n\n现在写主循环。\n\n```js\nlet last = 0;\nfunction loop(now) {\n  if (!last) last = now;\n  let dt = (now - last) / 1000;\n  last = now;\n  if (dt > 0.05) dt = 0.05;\n  update(dt);\n  render();\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n```\n\n好。\n\n现在写更新函数。\n\n```js\nfunction update(dt) {\n  if (S.accel) S.speed += 0.75 * dt;\n  if (S.brake) S.speed -= 1.9 * dt;\n  if (!S.accel && !S.brake) S.speed -= 0.35 * dt;\n  S.speed = Math.max(0, Math.min(1, S.speed));\n\n  let target = 0;\n  if (S.left) target -= 1;\n  if (S.right) target += 1;\n  S.tilt += (target - S.tilt) * Math.min(1, dt * 8);\n\n  S.wheel += S.speed * 1500 * dt;\n  S.crank += S.speed * 480 * dt;\n\n  S.roadScroll += S.speed * 700 * dt;\n  S.treeScroll += S.speed * 180 * dt;\n  S.hillScroll += S.speed * 45 * dt;\n  S.hillFarScroll += S.speed * 22 * dt;\n}\n```\n\n好。\n\n现在，有个问题：当速度为 0 时，车轮和曲柄会停止转动。✓\n\n好。\n\n让我把整个东西组装起来。\n\n再检查一下：`S.tilt` 的范围是 -1 到 1，旋转角度是 ±6°。\n\n好。\n\n现在写最终的 HTML。\n\n还要加上 `touch-action: none` 到按钮上，防止滚动。\n\n还有，加上 `-webkit-tap-highlight-color: transparent`。\n\n好。\n\n让我把它全部写出来。\n\n关于 `use` 元素——我需要确保 `href` 属性生效。在现代浏览器里，SVG2 的 `href` 是支持的。✓\n\n好。\n\n让我写最终答案。\n\n其实，等等。对于山丘层，我有：\n\n```html\n<g id=\"hillFarLayer\">\n  <use href=\"#hillFarShape\" x=\"-600\"/>\n  <use href=\"#hillFarShape\" x=\"0\"/>\n  <use href=\"#hillFarShape\" x=\"600\"/>\n</g>\n```\n\n平移范围是 [0, 600]。当平移 -600 时，位置是：-1200、-600、0。所以覆盖了 -1200 到 600。但视图是 0 到 900。所以 600 到 900 之间有个缺口。\n\n需要再加一个 `<use x=\"1200\"/>`。\n\n平移范围 [0,600] 时：\n- 在 -600 处：-1200、-600、0、600\n- 在 0 处：-600、0、600、1200\n\n所以 x=-600、0、600、1200 能覆盖 -1200 到 1800。✓\n\n好，加上 x=\"1200\"。\n\n同样，山丘层宽度 450，平移范围 [0,450]：\n在 -450 处：-900、-450、0、450、900\n在 0 处：-450、0、450、900\n\n所以 x = -450、0、450、900 能覆盖 -900 到 1350。✓\n\n好。\n\n树木层宽度 300，平移范围 [0,300]：\nx = -300、0、300、600、900、1200\n在 -300 处：-600、-300、0、300、600、900\n在 0 处：-300、0、300、600、900、1200\n\n覆盖 -600 到 1500。✓\n\n好。\n\n让我把所有这些都写出来。\n\n现在开始写最终代码。\n\n再检查一下树的形状：底部在 y=300。\n\n```html\n<g id=\"treeShape\">\n  <rect x=\"66\" y=\"252\" width=\"8\" height=\"48\" rx=\"3\" fill=\"#6b4f3a\"/>\n  <circle cx=\"70\" cy=\"242\" r=\"26\" fill=\"#4f9c62\"/>\n  <circle cx=\"50\" cy=\"254\" r=\"17\" fill=\"#438a55\"/>\n  <circle cx=\"90\" cy=\"254\" r=\"17\" fill=\"#438a55\"/>\n  <rect x=\"206\" y=\"262\" width=\"6\" height=\"38\" rx=\"3\" fill=\"#6b4f3a\"/>\n  <circle cx=\"209\" cy