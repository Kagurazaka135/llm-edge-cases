n�õģ���ʼд��\n\n���ڴ���ǳ������һ���ֶ���д������ע�͡�\n\n�ҿ�ʼ�ˡ�\n\nʵ���ϣ��һ���Ҫ����������——��ˮ�Ĳ���Ч����\n\n�һử����ˮƽ�ߣ�ÿ���ߵ�yλ�ö���sin������һ��ƫ�ơ�\n\n��ˮ����ɫ：���ɫ���䵽����ɫ��\n\n��ӳ：�ں�ˮ�л���·�Ƶĵ�Ӱ——���·�ƵĹ�Ӱ���·�ת��y�ᷴת������ģ����\n\nΪ�˼򵥣��һ�ֻ���һЩ��ɫ�Ĺ�Ӱ�ߡ�\n\n���ˣ���ʼд��\n\n�һ�дһ����Ϊ\"Seaside Night Ride\"�ĳ�����\n\nȫ��������һ��HTML�ļ��С�\n\n��д�Ĺ����У��һ�ע����룬ȷ����������\n\n���ˣ���ʼ��\n\n���ڣ���ע�һ����Ҫ�����⣺\n1. Canvas�ڲ��ߴ�1200x800\n2. ʹ��scale����Ӧ\n3. ȫ��ʹ��requestAnimationFrame\n4. ���ƺ���ģ�黯\n\n��д��\n\n���ڴ���ǳ������һᾡ�������Ľṹ��\n\n�ҽ�����д��\n\nע�⣺���г��ĳ��֡���̤���Ȳ�����Ҫ��time������\n\n�ҽ�ʹ��`performance.now()`����ȡʱ�䡣\n\n```javascript\nlet startTime = performance.now();\nfunction animate(timestamp) {\n    const time = (timestamp - startTime) / 1000; // ��\n    // ...\n}\n```\n\n�õġ�\n\n���ڣ��ҿ�ʼдHTML�ļ���\n\n����ע�⣬�һ���Ҫ���������ǵ���˸——ʹ��sin(time * twinkleSpeed + twinklePhase)�����ȱ仯��\n\n��ˮ����——ʹ�ö���ҵ���，yƫ����sin(time * waveSpeed + x * waveFreq)��\n\n��·��——·���ϵı����ߣ�ʹ�����ߡ�\n\n�õģ�д��\n\n���ڣ��ҿ�ʼ���롣\n\n���ڴ���ǳ������һ����ṩһ�������Ĵ��롣\n\n�һ��ھ��ĵؽṹ�����롣\n\n��ʼ：\n\n���ȣ�HTML�ṹ��\n\n```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>���� - ҹ���</title>\n    <style>\n        /* CSS */\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <script>\n        // JS\n    </script>\n</body>\n</html>\n```\n\nCSS：\n```css\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { \n    width: 100vw; height: 100vh; \n    overflow: hidden; \n    background: #000;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\ncanvas {\n    display: block;\n}\n```\n\nJS：\n- ��ȡcanvas\n- ���óߴ�\n- ���ƺ���\n- ����ѭ��\n\n�õģ���ʼд��\n\n�һ���д�����д��롣\n\n���ڣ��ҿ�ʼдJS���֡�\n\n�һ��ȶ���һЩȫ�ֳ����ͱ�����\n\nȻ��дresize������\n\nȻ��д����ѭ����\n\nȻ��д���ֻ��ƺ�����\n\n���ˣ���ʼ��\n\nʵ���ϣ��һ���Ҫ���������ǡ��һ�Ԥ������һ�����ǵ����顣\n\n```javascript\nconst stars = [];\nfor (let i = 0; i < 150; i++) {\n    stars.push({\n        x: Math.random() * W,\n        y: Math.random() * 250, // �Ϸ������\n        r: Math.random() * 1.5 + 0.5,\n        twinkleSpeed: Math.random() * 2 + 0.5,\n        twinklePhase: Math.random() * Math.PI * 2,\n        baseAlpha: Math.random() * 0.5 + 0.5\n    });\n}\n```\n\n��ˮ�Ĳ��Σ�\n- �һử����ҵ�ˮƽ�ߣ�ÿ������yƫ��\n\n���ڣ��ҿ�ʼд��ϸ�Ĵ��롣\n\n�һ��ر�ע�⻭�Ƶ�˳��——��Զ��������ǰ����\n\n1. ���\n2. ���Ǳ���\n3. Զ��ɽ��/��ƽ��\n4. ���棨��ˮ��\n5. ��ˮ��ӳ\n6. ɳ̲\n7. ��·����\n8. ·��\n9. �����·��（Զ����\n10. ��·����\n11. ���г�\n12. ������\n13. ������·�ƣ�������\n14. ǰ���ݴԺ�ʯͷ\n\n���ˣ�д��\n\n���ڣ��ҿ�ʼд�����Ĵ��롣\n\n���ڴ���ǳ������һ���ṩ���д��롣\n\n�ҽ�дһ��������800�д��Ĵ��롣\n\nʵ���ϣ��һᾡ��д�ø���ϸһЩ��\n\n��ʼ��\n\n�ڱ�д������ʱ�һ�ע�⣺\n- ʹ��ctx.save()��ctx.restore()\n- ʹ��ctx.globalAlpha\n- ʹ��ctx.createLinearGradient��ctx.createRadialGradient\n\n�õģ���ʼ��\n\n���ڳ��ֵķ���������ת——wheelAngle = time * 2.0��\n\n��̤�Ƕ�——pedalAngle = time * 5.0��ÿ��Լ0.8Ȧ��ʵ����5 rad/sԼ0.8Ȧ/�룬̫���ˡ���Ϊ2.5Ȧ/�� = 5*PI rad/s ≈ 15.7 rad/s���Ǿ���pedalAngle = time * 15��\n\nʵ���ϣ�������̤�ٶ�：ÿ��2Ȧ = 4*PI rad/s ≈ 12.6 rad/s������pedalAngle = time * 12.6��\n\n�õġ�\n\nwheelAngle��pedalAngle * (chainringRadius / wheelRadius) * 2������2����Ϊ���ֺͷ����ֵĳ��ֱȡ�chainringRadius=12, wheelRadius=35, chainringRadius/wheelRadius ≈ 0.34������wheelAngle = pedalAngle * 0.34 * 2 ≈ pedalAngle * 0.68��\n\n���߸ɴ�wheelAngle = time * 8.5（��������\n\n�õġ�\n\n���ڣ���ʼд������\n\nʵ���ϣ��һ��ø���ϸ�ķ�ʽ��д��\n\n��дʱ���һ�ѭ����\n- �ȶ������г�λ�ò���\n- Ȼ����Ƴ���\n- Ȼ����Ƴ���\n- Ȼ����Ƴ�̤\n- Ȼ��������\n\n���ˣ���ʼд��\n\n�һ��Ȱѿ�ܴ�ã�Ȼ����ϸ�ڡ�\n\n���ڣ��ҿ�ʼдHTML�ļ���\n\n��Ϊ����ܳ����һ���ȷ���ṹ������\n\n�õģ���д�ˡ�\n\n��ע�⣬ʹ��`ctx.lineCap = 'round'`��`ctx.lineJoin = 'round'`������߶ο�������\n\n���г��Ŀ�ܹܲĴ�ϸ��\n- ���Ǽ��Ϲܣ�lineWidth 6\n- �¹ܣ�lineWidth 7\n- ���ܣ�lineWidth 6\n- ���²��lineWidth 5\n- ���ϲ��lineWidth 5\n- ǰ�棺lineWidth 6\n\n��̥：lineWidth 5\n��Ȧ：lineWidth 2\n\n���ˣ���ʼд��\n\n�һ���дһЩ������\n\n�õģ���ʼ��\n\n���ڣ��һ���Ҫ���ƹ�·�ƵĹ�â——�⽫�ǳ����Ӿ�Ч����\n\n�һ�ʹ��radialGradient，���Ĳ�����ɫ�����ⲿ����\n\n```javascript\nconst glowGradient = ctx.createRadialGradient(lampLightX, lampLightY, 0, lampLightX, lampLightY, 120);\nglowGradient.addColorStop(0, 'rgba(255, 240, 200, 0.6)');\nglowGradient.addColorStop(0.3, 'rgba(255, 220, 150, 0.3)');\nglowGradient.addColorStop(0.7, 'rgba(255, 180, 100, 0.05)');\nglowGradient.addColorStop(1, 'rgba(255, 150, 50, 0)');\n```\n\nȻ���ڵ����ϻ���һ����Ӱ——ʹ��ellipse��\n\n���ˣ�д��\n\n���ڣ��ҿ�ʼд�����Ĵ��롣\n\n�һ�дһ��800-1000�еĴ��롣\n\nʵ���ϣ�Ϊ�˿ɶ��ԣ��һ���дע�͡�\n\n��ʼд��\n\n���ȣ�HTML��CSS��\n\n��HTML���֣�\n```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>ҹ������� - ��������</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            width: 100vw;\n            height: 100vh;\n            overflow: hidden;\n            background: #0a0a0f;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n        canvas {\n            display: block;\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <script>\n        // ... ���д���\n    </script>\n</body>\n</html>\n```\n\nȻ��JS���֡�\n\n�ҽ��ṩ�����Ĵ��롣\n\n��ʼдJS��\n\n```javascript\n(function() {\n    const canvas = document.getElementById('canvas');\n    const ctx = canvas.getContext('2d');\n    \n    const W = 1200;\n    const H = 800;\n    \n    let scale = 1;\n    let offsetX = 0;\n    let offsetY = 0;\n    \n    function resize() {\n        const w = window.innerWidth;\n        const h = window.innerHeight;\n        canvas.width = w;\n        canvas.height = h;\n        scale = Math.min(w / W, h / H);\n        offsetX = (w - W * scale) / 2;\n        offsetY = (h - H * scale) / 2;\n    }\n    \n    window.addEventListener('resize', resize);\n    resize();\n    \n    // ���Ǳ���\n    const stars = [];\n    for (let i = 0; i < 180; i++) {\n        stars.push({\n            x: Math.random() * W,\n            y: Math.random() * 280,\n            r: Math.random() * 1.8 + 0.4,\n            speed: Math.random() * 2.5 + 0.8,\n            phase: Math.random() * Math.PI * 2,\n            baseAlpha: Math.random() * 0.6 + 0.4\n        });\n    }\n    \n    // ��ʼʱ��\n    const startTime = performance.now();\n    \n    // ���ƺ���\n    function drawSky(time) {\n        // ҹ���ݱ�\n        const skyGrad = ctx.createLinearGradient(0, 0, 0, 350);\n        skyGrad.addColorStop(0, '#0a0a1a');\n        skyGrad.addColorStop(0.5, '#111133');\n        skyGrad.addColorStop(1, '#1a1a3a');\n        ctx.fillStyle = skyGrad;\n        ctx.fillRect(0, 0, W, 350);\n    }\n    \n    function drawStars(time) {\n        for (const star of stars) {\n            const alpha = star.baseAlpha * (0.6 + 0.4 * Math.sin(time * star.speed + star.phase));\n            ctx.fillStyle = `rgba(255, 255, 240, ${alpha})`;\n            ctx.beginPath();\n            ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);\n            ctx.fill();\n        }\n    }\n    \n    function drawSea(time) {\n        // ��ˮ\n        const seaGrad = ctx.createLinearGradient(0, 330, 0, 520);\n        seaGrad.addColorStop(0, '#0a1a2a');\n        seaGrad.addColorStop(0.3, '#0d2035');\n        seaGrad.addColorStop(0.7, '#0f2540');\n        seaGrad.addColorStop(1, '#152840');\n        ctx.fillStyle = seaGrad;\n        ctx.fillRect(0, 330, W, 190);\n        \n        // ����\n        ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';\n        ctx.lineWidth = 1;\n        for (let i = 0; i < 12; i++) {\n            const baseY = 340 + i * 15;\n            ctx.beginPath();\n            for (let x = 0; x < W; x += 10) {\n                const y = baseY + Math.sin(time * 1.5 + x * 0.02 + i * 0.7) * 4;\n                if (x === 0) ctx.moveTo(x, y);\n                else ctx.lineTo(x, y);\n            }\n            ctx.stroke();\n        }\n        \n        // ��·�Ƶ�ӳ�ں�ˮ��\n        const reflectionGrad = ctx.createLinearGradient(0, 350, 0, 480);\n        reflectionGrad.addColorStop(0, 'rgba(255, 200, 100, 0.08)');\n        reflectionGrad.addColorStop(1, 'rgba(255, 200, 100, 0)');\n        ctx.fillStyle = reflectionGrad;\n        ctx.beginPath();\n        // ��ӳ����\n        const reflX = 850;\n        const reflWidth = 80;\n        ctx.moveTo(reflX - reflWidth, 350);\n        ctx.quadraticCurveTo(reflX, 420, reflX - reflWidth * 0.3, 480);\n        ctx.lineTo(reflX + reflWidth * 0.3, 480);\n        ctx.quadraticCurveTo(reflX, 420, reflX + reflWidth, 350);\n        ctx.fill();\n    }\n    \n    function drawShore(time) {\n        // ɳ̲/���߹��ɴ�\n        const shoreGrad = ctx.createLinearGradient(0, 500, 0, 560);\n        shoreGrad.addColorStop(0, '#2a3040');\n        shoreGrad.addColorStop(0.5, '#3a3a35');\n        shoreGrad.addColorStop(1, '#4a4a3a');\n        ctx.fillStyle = shoreGrad;\n        ctx.fillRect(0, 500, W, 60);\n    }\n    \n    function drawRoad(time) {\n        // ��·����\n        const roadGrad = ctx.createLinearGradient(0, 550, 0, 700);\n        roadGrad.addColorStop(0, '#3a3a3a');\n        roadGrad.addColorStop(1, '#2a2a2a');\n        ctx.fillStyle = roadGrad;\n        ctx.fillRect(0, 550, W, 150);\n        \n        // ·��\n        ctx.fillStyle = '#4a4a4a';\n        ctx.fillRect(0, 548, W, 6);\n        ctx.fillStyle = '#5a5a5a';\n        ctx.fillRect(0, 694, W, 6);\n        \n        // ·������\n        ctx.strokeStyle = '#cccccc';\n        ctx.lineWidth = 3;\n        ctx.setLineDash([30, 20]);\n        ctx.beginPath();\n        ctx.moveTo(0, 622);\n        ctx.lineTo(W, 622);\n        ctx.stroke();\n        ctx.setLineDash([]);\n    }\n    \n    function drawLampPost(x, baseY, time) {\n        // ��·�ƻ���\n        const baseX = x;\n        const baseTop = baseY - 8;\n        \n        // ����\n        ctx.fillStyle = '#3a3a3a';\n        ctx.fillRect(baseX - 12, baseTop, 24, 10);\n        ctx.fillStyle = '#4a4a4a';\n        ctx.fillRect(baseX - 10, baseTop - 2, 20, 4);\n        \n        // �Ƹ�\n        const poleBottom = baseTop;\n        const poleTop = baseY - 250;\n        ctx.strokeStyle = '#5a5a5a';\n        ctx.lineWidth = 6;\n        ctx.beginPath();\n        ctx.moveTo(baseX, poleBottom);\n        ctx.lineTo(baseX, poleTop);\n        ctx.stroke();\n        \n        // �Ƹ�װ��\n        ctx.strokeStyle = '#6a6a6a';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(baseX - 3, poleBottom - 20);\n        ctx.lineTo(baseX + 3, poleBottom - 20);\n        ctx.stroke();\n        \n        // �Ʊ�\n        const armStartY = poleTop + 20;\n        const armEndX = baseX - 60;\n        const armEndY = poleTop - 10;\n        ctx.strokeStyle = '#5a5a5a';\n        ctx.lineWidth = 5;\n        ctx.beginPath();\n        ctx.moveTo(baseX, armStartY);\n        ctx.quadraticCurveTo(baseX - 20, armStartY - 10, armEndX, armEndY);\n        ctx.stroke();\n        \n        // �ƾ�\n        const lampX = armEndX;\n        const lampY = armEndY;\n        \n        // �ƾ���\n        ctx.fillStyle = '#3a3a3a';\n        ctx.beginPath();\n        ctx.moveTo(lampX - 15, lampY);\n        ctx.lineTo(lampX + 15, lampY);\n        ctx.lineTo(lampX + 10, lampY + 15);\n        ctx.lineTo(lampX - 10, lampY + 15);\n        ctx.closePath();\n        ctx.fill();\n        ctx.strokeStyle = '#5a5a5a';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n        \n        // �ƹ��â\n        const glowGrad = ctx.createRadialGradient(lampX, lampY + 8, 5, lampX, lampY + 8, 150);\n        glowGrad.addColorStop(0, 'rgba(255, 240, 200, 0.5)');\n        glowGrad.addColorStop(0.2, 'rgba(255, 220, 150, 0.3)');\n        glowGrad.addColorStop(0.5, 'rgba(255, 180, 100, 0.08)');\n        glowGrad.addColorStop(1, 'rgba(255, 150, 50, 0)');\n        ctx.fillStyle = glowGrad;\n        ctx.beginPath();\n        ctx.arc(lampX, lampY + 8, 150, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // �ƹ����Ĺ��\n        const glowGrad2 = ctx.createRadialGradient(lampX, lampY + 8, 0, lampX, lampY + 8, 30);\n        glowGrad2.addColorStop(0, 'rgba(255, 255, 230, 0.7)');\n        glowGrad2.addColorStop(0.5, 'rgba(255, 240, 200, 0.3)');\n        glowGrad2.addColorStop(1, 'rgba(255, 200, 100, 0)');\n        ctx.fillStyle = glowGrad2;\n        ctx.beginPath();\n        ctx.arc(lampX, lampY + 8, 30, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // �����ϵĹ��\n        const groundGlow = ctx.createEllipseGradient ? null : null;\n        // ʹ��radialGradientģ������ϵĹ��\n        ctx.save();\n        ctx.globalAlpha = 0.25;\n        const groundGlowGrad = ctx.createRadialGradient(lampX, baseY, 10, lampX, baseY, 100);\n        groundGlowGrad.addColorStop(0, 'rgba(255, 220, 150, 0.6)');\n        groundGlowGrad.addColorStop(0.5, 'rgba(255, 180, 100, 0.2)');\n        groundGlowGrad.addColorStop(1, 'rgba(255, 150, 50, 0)');\n        ctx.fillStyle = groundGlowGrad;\n        ctx.beginPath();\n        ctx.ellipse(lampX, baseY, 100, 25, 0, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n        \n        return { lampX, lampY: lampY + 8, baseY, baseX };\n    }\n    \n    function drawCar(x, y, time) {\n        // ��·����С����\n        const carW = 50;\n        const carH = 22;\n        \n        ctx.save();\n        ctx.translate(x, y);\n        \n        // ��Ӱ\n        ctx.fillStyle = 'rgba(0,0,0,0.4)';\n        ctx.beginPath();\n        ctx.ellipse(0, 8, carW/2 + 5, 6, 0, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // ����\n        ctx.fillStyle = '#2a3a4a';\n        ctx.beginPath();\n        ctx.roundRect(-carW/2, -carH, carW, carH, 5);\n        ctx.fill();\n        \n        // ����\n        ctx.fillStyle = '#1a2a3a';\n        ctx.beginPath();\n        ctx.roundRect(-carW/2 + 8, -carH - 8, carW - 16, 10, 4);\n        ctx.fill();\n        \n        // ����\n        ctx.fillStyle = 'rgba(180, 200, 220, 0.6)';\n        ctx.beginPath();\n        ctx.roundRect(-carW/2 + 10, -carH - 6, carW/2 - 6, 6, 2);\n        ctx.fill();\n        ctx.beginPath();\n        ctx.roundRect(carW/2 - carW/2 - 4, -carH - 6, carW/2 - 6, 6, 2);\n        ctx.fill();\n        \n        // ǰ����\n        ctx.fillStyle = 'rgba(255, 255, 200, 0.8)';\n        ctx.beginPath();\n        ctx.arc(carW/2 - 5, -carH/2, 3, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = 'rgba(255, 100, 50, 0.8)';\n        ctx.beginPath();\n        ctx.arc(-carW/2 + 5, -carH/2, 3, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // ǰ�ƹ�Ͷ��\n        ctx.fillStyle = 'rgba(255, 255, 200, 0.15)';\n        ctx.beginPath();\n        ctx.moveTo(carW/2, -carH/2);\n        ctx.lineTo(carW/2 + 40, -carH/2 - 10);\n        ctx.lineTo(carW/2 + 40, -carH/2 + 10);\n        ctx.closePath();\n        ctx.fill();\n        \n        // ����\n        ctx.fillStyle = '#111';\n        ctx.beginPath();\n        ctx.arc(-carW/3, carH/2 - 1, 8, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.beginPath();\n        ctx.arc(carW/3, carH/2 - 1, 8, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#333';\n        ctx.beginPath();\n        ctx.arc(-carW/3, carH/2 - 1, 4, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.beginPath();\n        ctx.arc(carW/3, carH/2 - 1, 4, 0, Math.PI * 2);\n        ctx.fill();\n        \n        ctx.restore();\n    }\n    \n    function drawBicycle(bikeX, bikeY, time) {\n        // ���г����ƺ���\n        const pedalAngle = time * 12.0; // ÿ��Լ2Ȧ\n        const wheelAngle = time * 8.0;\n        \n        // ���Ĳ���\n        const frontWheelCX = bikeX - 85;\n        const frontWheelCY = bikeY - 35;\n        const rearWheelCX = bikeX + 85;\n        const rearWheelCY = bikeY - 35;\n        const wheelR = 35;\n        \n        const headTubeTopX = bikeX - 115;\n        const headTubeTopY = bikeY - 75;\n        const headTubeBottomX = bikeX - 105;\n        const headTubeBottomY = bikeY - 50;\n        \n        const seatTubeTopX = bikeX + 35;\n        const seatTubeTopY = bikeY - 70;\n        const seatTubeBottomX = bikeX + 25;\n        const seatTubeBottomY = bikeY - 5;\n        \n        const crankCenterX = seatTubeBottomX;\n        const crankCenterY = seatTubeBottomY;\n        const crankR = 12; // �����ְ뾶\n        const crankArmLen = 20;\n        \n        // ��̤λ��\n        const leftPedalAngle = pedalAngle;\n        const rightPedalAngle = pedalAngle + Math.PI;\n        const leftPedalX = crankCenterX + crankArmLen * Math.cos(leftPedalAngle);\n        const leftPedalY = crankCenterY + crankArmLen * Math.sin(leftPedalAngle);\n        const rightPedalX = crankCenterX + crankArmLen * Math.cos(rightPedalAngle);\n        const rightPedalY = crankCenterY + crankArmLen * Math.sin(rightPedalAngle);\n        \n        // ���Ƴ���\n        function drawWheel(cx, cy, r, angle) {\n            // ��̥\n            ctx.strokeStyle = '#1a1a1a';\n            ctx.lineWidth = 7;\n            ctx.beginPath();\n            ctx.arc(cx, cy, r, 0, Math.PI * 2);\n            ctx.stroke();\n            \n            // ��Ȧ\n            ctx.strokeStyle = '#b0b0b0';\n            ctx.lineWidth = 2.5;\n            ctx.beginPath();\n            ctx.arc(cx, cy, r - 4, 0, Math.PI * 2);\n            ctx.stroke();\n            \n            // ���ᣨ���֣�\n            ctx.fillStyle = '#888';\n            ctx.beginPath();\n            ctx.arc(cx, cy, 5, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.fillStyle = '#ccc';\n            ctx.beginPath();\n            ctx.arc(cx, cy, 2.5, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // ����\n            const spokeCount = 18;\n            ctx.strokeStyle = '#999';\n            ctx.lineWidth = 0.8;\n            for (let i = 0; i < spokeCount; i++) {\n                const a = angle + (i / spokeCount) * Math.PI * 2;\n                const innerR = 5;\n                const outerR = r - 5;\n                ctx.beginPath();\n                ctx.moveTo(cx + innerR * Math.cos(a), cy + innerR * Math.sin(a));\n                ctx.lineTo(cx + outerR * Math.cos(a), cy + outerR * Math.sin(a));\n                ctx.stroke();\n            }\n        }\n        \n        // ���Ƴ���\n        drawWheel(frontWheelCX, frontWheelCY, wheelR, wheelAngle);\n        drawWheel(rearWheelCX, rearWheelCY, wheelR, wheelAngle);\n        \n        // ���Ƴ��Ǽ�\n        ctx.strokeStyle = '#c0392b';\n        ctx.lineWidth = 6;\n        ctx.lineCap = 'round';\n        ctx.lineJoin = 'round';\n        \n        // �Ϲ� (top tube)\n        ctx.beginPath();\n        ctx.moveTo(headTubeTopX, headTubeTopY);\n        ctx.lineTo(seatTubeTopX, seatTubeTopY);\n        ctx.stroke();\n        \n        // �¹� (down tube)\n        ctx.lineWidth = 7;\n        ctx.beginPath();\n        ctx.moveTo(headTubeBottomX, headTubeBottomY);\n        ctx.lineTo(seatTubeBottomX, seatTubeBottomY);\n        ctx.stroke();\n        \n        // ���� (seat tube)\n        ctx.lineWidth = 6;\n        ctx.beginPath();\n        ctx.moveTo(seatTubeTopX, seatTubeTopY);\n        ctx.lineTo(seatTubeBottomX, seatTubeBottomY);\n        ctx.stroke();\n        \n        // ���²� (chain stay)\n        ctx.lineWidth = 5;\n        ctx.beginPath();\n        ctx.moveTo(seatTubeBottomX, seatTubeBottomY);\n        ctx.lineTo(rearWheelCX, rearWheelCY);\n        ctx.stroke();\n        \n        // ���ϲ� (seat stay)\n        ctx.lineWidth = 5;\n        ctx.beginPath();\n        ctx.moveTo(seatTubeTopX, seatTubeTopY);\n        ctx.lineTo(rearWheelCX, rearWheelCY);\n        ctx.stroke();\n        \n        // ǰ�� (fork)\n        ctx.lineWidth = 6;\n        ctx.beginPath();\n        ctx.moveTo(headTubeBottomX, headTubeBottomY);\n        ctx.lineTo(frontWheelCX, frontWheelCY);\n        ctx.stroke();\n        \n        // ǰ�泵�� (head tube)\n        ctx.strokeStyle = '#888';\n        ctx.lineWidth = 8;\n        ctx.beginPath();\n        ctx.moveTo(headTubeTopX, headTubeTopY);\n        ctx.lineTo(headTubeBottomX, headTubeBottomY);\n        ctx.stroke();\n        \n        // ���� (handlebar)\n        ctx.strokeStyle = '#555';\n        ctx.lineWidth = 5;\n        const handlebarCX = headTubeTopX;\n        const handlebarCY = headTubeTopY - 5;\n        ctx.beginPath();\n        ctx.arc(handlebarCX, handlebarCY, 12, -Math.PI * 0.7, Math.PI * 0.2);\n        ctx.stroke();\n        \n        // ���Ѻ�����\n        // ����\n        ctx.strokeStyle = '#777';\n        ctx.lineWidth = 4;\n        ctx.beginPath();\n        ctx.moveTo(seatTubeTopX, seatTubeTopY - 5);\n        ctx.lineTo(seatTubeTopX, seatTubeTopY - 18);\n        ctx.stroke();\n        \n        // ����\n        ctx.fillStyle = '#5d3a1a';\n        ctx.beginPath();\n        ctx.ellipse(seatTubeTopX, seatTubeTopY - 20, 16, 6, 0, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.strokeStyle = '#3a2010';\n        ctx.lineWidth = 1.5;\n        ctx.stroke();\n        \n        // ������ (chainring)\n        ctx.fillStyle = '#444';\n        ctx.beginPath();\n        ctx.arc(crankCenterX, crankCenterY, crankR, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.strokeStyle = '#555';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.arc(crankCenterX, crankCenterY, crankR, 0, Math.PI * 2);\n        ctx.stroke();\n        // ��������\n        ctx.fillStyle = '#333';\n        ctx.beginPath();\n        ctx.arc(crankCenterX, crankCenterY, 4, 0, Math.PI * 2);\n        ctx.fill();\n        \n        // ������ (chain)\n        ctx.strokeStyle = '#555';\n        ctx.lineWidth = 1.5;\n        ctx.setLineDash([3, 2]);\n        // �����������ֵ�����\n        const rearGearR = 6;\n        ctx.beginPath();\n        ctx.moveTo(crankCenterX + crankR, crankCenterY);\n        ctx.lineTo(rearWheelCX + rearGearR, rearWheelCY);\n        ctx.stroke();\n        ctx.beginPath();\n        ctx.moveTo(crankCenterX - crankR, crankCenterY);\n        ctx.lineTo(rearWheelCX - rearGearR, rearWheelCY);\n        ctx.stroke();\n        ctx.setLineDash([]);\n        \n        // ��̤��\n        function drawCrankArm(startX, startY, endX, endY) {\n            ctx.strokeStyle = '#666';\n            ctx.lineWidth = 5;\n            ctx.lineCap = 'round';\n            ctx.beginPath();\n            ctx.moveTo(startX, startY);\n            ctx.lineTo(endX, endY);\n            ctx.stroke();\n        }\n        \n        function drawPedal(pedalX, pedalY, angle) {\n            ctx.save();\n            ctx.translate(pedalX, pedalY);\n            // ��̤�屣�屣�ִ���ˮƽ\n            ctx.fillStyle = '#555';\n            ctx.fillRect(-10, -3, 20, 6);\n            ctx.strokeStyle = '#333';\n            ctx.lineWidth = 1;\n            ctx.strokeRect(-10, -3, 20, 6);\n            ctx.restore();\n        }\n        \n        // ������̤\n        // left pedal (�����ǵ�һ�ࣩ\n        drawCrankArm(crankCenterX, crankCenterY, leftPedalX, leftPedalY);\n        drawPedal(leftPedalX, leftPedalY, leftPedalAngle);\n        \n        // right pedal (Զ����һ�ࣩ\n        drawCrankArm(crankCenterX, crankCenterY, rightPedalX, rightPedalY);\n        drawPedal(rightPedalX, rightPedalY, rightPedalAngle);\n        \n        // ��������\n        return {\n            seatX: seatTubeTopX,\n            seatY: seatTubeTopY - 20,\n            handleX: handlebarCX,\n            handleY: handlebarCY,\n            leftPedalX, leftPedalY,\n            rightPedalX, rightPedalY,\n            crankCenterX, crankCenterY,\n            headTubeTopX, headTubeTopY\n        };\n    }\n    \n    function drawRider(seatX, seatY, handleX, handleY, leftPedalX, leftPedalY, rightPedalX, rightPedalY, time) {\n        // ��������\n        const hipX = seatX + 5;\n        const hipY = seatY - 5;\n        \n        // ͷ��\n        const headCX = hipX + 5;\n        const headCY = hipY - 45;\n        \n        // ͷ��\n        ctx.fillStyle = '#ffccaa';\n        ctx.beginPath();\n        ctx.arc(headCX, headCY, 14, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.strokeStyle = '#ddaa88';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n        \n        // ͷ��\n        ctx.fillStyle = '#2c3e50';\n        ctx.beginPath();\n        ctx.arc(headCX, headCY - 8, 15, Math.PI, Math.PI * 2);\n        ctx.fill();\n        ctx.fillRect(headCX - 15, headCY - 8, 30, 5);\n        \n        // ����\n        ctx.strokeStyle = '#334455';\n        ctx.lineWidth = 10;\n        ctx.lineCap = 'round';\n        ctx.beginPath();\n        ctx.moveTo(hipX, hipY);\n        ctx.lineTo(hipX + 5, hipY - 30);\n        ctx.stroke();\n        \n        // �ֱ�\n        // �ϱ�\n        ctx.strokeStyle = '#445566';\n        ctx.lineWidth = 6;\n        ctx.beginPath();\n        ctx.moveTo(hipX + 5, hipY - 25);\n        ctx.lineTo(handleX, handleY + 5);\n        ctx.stroke();\n        // ǰ��\n        ctx.beginPath();\n        ctx.moveTo(handleX, handleY + 5);\n        ctx.lineTo(handleX - 8, handleY + 12);\n        ctx.stroke();\n        \n        // �Ȳ�����\n        function drawLeg(hipX, hipY, pedalX, pedalY, side) {\n            // ϥ��λ��\n            const knee = calculateKnee(hipX, hipY, pedalX, pedalY, 32, 32, side);\n            \n            // ����\n            ctx.strokeStyle = '#334455';\n            ctx.lineWidth = 9;\n            ctx.lineCap = 'round';\n            ctx.beginPath();\n            ctx.moveTo(hipX, hipY);\n            ctx.lineTo(knee.x, knee.y);\n            ctx.stroke();\n            \n            // С��\n            ctx.strokeStyle = '#445566';\n            ctx.lineWidth = 7;\n            ctx.beginPath();\n            ctx.moveTo(knee.x, knee.y);\n            ctx.lineTo(pedalX, pedalY);\n            ctx.stroke();\n            \n            // ϥ��\n            ctx.fillStyle = '#334455';\n            ctx.beginPath();\n            ctx.arc(knee.x, knee.y, 5, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // �ţ�Ь��\n            ctx.fillStyle = '#2a2a2a';\n            ctx.save();\n            ctx.translate(pedalX, pedalY);\n            ctx.beginPath();\n            ctx.ellipse(0, 1, 8, 4, 0.1, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.restore();\n        }\n        \n        // ���Ȳ��ƣ�leftPedal�ǽ����\n        drawLeg(hipX, hipY, leftPedalX, leftPedalY, 1);\n        // rightPedal��Զ���\n        drawLeg(hipX, hipY, rightPedalX, rightPedalY, -1);\n    }\n    \n    function calculateKnee(hipX, hipY, ankleX, ankleY, thighLen, shinLen, direction) {\n        const dx = ankleX - hipX;\n        const dy = ankleY - hipY;\n        const d = Math.sqrt(dx * dx + dy * dy);\n        const midX = (hipX + ankleX) / 2;\n        const midY = (hipY + ankleY) / 2;\n        const halfD = d / 2;\n        let offset = Math.sqrt(Math.max(thighLen * thighLen - halfD * halfD, 0));\n        if (d > thighLen + shinLen) offset = 0;\n        if (d < 0.001) return { x: midX, y: midY };\n        const perpX = -dy / d * offset * direction;\n        const perpY = dx / d * offset * direction;\n        return { x: midX + perpX, y: midY + perpY };\n    }\n    \n    // ���Ʋݴ�\n    function drawBushes(time) {\n        // ·�ߵ�С�ݴ�\n        const bushPositions = [\n            { x: 150, y: 545 },\n            { x: 300, y: 542 },\n            { x: 950, y: 545 },\n            { x: 1050, y: 543 },\n            { x: 80, y: 548 },\n            { x: 1120, y: 546 },\n        ];\n        \n        for (const bush of bushPositions) {\n            ctx.fillStyle = '#1a3a1a';\n            ctx.beginPath();\n            ctx.arc(bush.x, bush.y, 12, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.beginPath();\n            ctx.arc(bush.x - 8, bush.y + 2, 9, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.beginPath();\n            ctx.arc(bush.x + 8, bush.y + 2, 9, 0, Math.PI * 2);\n            ctx.fill();\n            ctx.fillStyle = '#2a4a2a';\n            ctx.beginPath();\n            ctx.arc(bush.x, bush.y - 3, 8, 0, Math.PI * 2);\n            ctx.fill();\n        }\n    }\n    \n    // ���ƺ�ƽ��/Զ��\n    function drawHorizon(time) {\n        // Զ����ɽ��\n        ctx.fillStyle = '#151525';\n        ctx.beginPath();\n        ctx.moveTo(0, 330);\n        for (let x = 0; x <= W; x += 50) {\n            const y = 320 + Math.sin(x * 0.005 + 1.5) * 8 + Math.sin(x * 0.012) * 5;\n            ctx.lineTo(x, y);\n        }\n        ctx.lineTo(W, 350);\n        ctx.lineTo(0, 350);\n        ctx.closePath();\n        ctx.fill();\n        \n        // ɽ���ϵ�ϸ��\n        ctx.fillStyle = '#1a1a30';\n        ctx.beginPath();\n        ctx.moveTo(0, 325);\n        for (let x = 0; x <= W; x += 40) {\n            const y = 318 + Math.sin(x * 0.008 + 2.0) * 6 + Math.sin(x * 0.015 + 1) * 4;\n            ctx.lineTo(x, y);\n        }\n        ctx.lineTo(W, 340);\n        ctx.lineTo(0, 340);\n        ctx.closePath();\n        ctx.fill();\n    }\n    \n    // ���ƶ���\n    function animate(timestamp) {\n        const time = (timestamp - startTime) / 1000;\n        \n        ctx.setTransform(1, 0, 0, 1, 0, 0);\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n        ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);\n        \n        // ���Ʊ���\n        drawSky(time);\n        drawStars(time);\n        drawHorizon(time);\n        drawSea(time);\n        drawShore(time);\n        drawRoad(time);\n        \n        // ���Ʋݴԣ�·�ߣ�\n        drawBushes(time);\n        \n        // ���ƹ�·�ƣ�Զ����\n        drawLampPost(200, 548, time);\n        \n        // ���ƹ�·����\n        const carSpeed = 70;\n        const carX = ((time * carSpeed) % (W + 300)) - 150;\n        drawCar(carX, 615, time);\n        \n        // ���ƹ�·�ƣ�������\n        drawLampPost(850, 548, time);\n        \n        // ���ƹ�·�ƣ���Զ����\n        drawLampPost(1050, 548, time);\n        \n        // �������г�\n        const bikeX = 580;\n        const bikeY = 600;\n        const bikeParts = draw