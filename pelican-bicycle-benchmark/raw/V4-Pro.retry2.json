iewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>ҹ - </title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        body {\n            width: 100vw;\n            height: 100vh;\n            overflow: hidden;\n            background: #050510;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            font-family: 'Arial', sans-serif;\n        }\n        canvas {\n            display: block;\n            cursor: default;\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <script>\n        (function() {\n            const canvas = document.getElementById('canvas');\n            const ctx = canvas.getContext('2d');\n\n            const W = 1200;\n            const H = 800;\n\n            let scale = 1;\n            let offsetX = 0;\n            let offsetY = 0;\n\n            function resize() {\n                const w = window.innerWidth;\n                const h = window.innerHeight;\n                canvas.width = w;\n                canvas.height = h;\n                scale = Math.min(w / W, h / H);\n                offsetX = (w - W * scale) / 2;\n                offsetY = (h - H * scale) / 2;\n            }\n\n            window.addEventListener('resize', resize);\n            resize();\n\n            // Ǳ - ˸\n            const stars = [];\n            for (let i = 0; i < 200; i++) {\n                stars.push({\n                    x: Math.random() * W,\n                    y: Math.random() * 290,\n                    r: Math.random() * 1.8 + 0.4,\n                    speed: Math.random() * 2.8 + 0.6,\n                    phase: Math.random() * Math.PI * 2,\n                    baseAlpha: Math.random() * 0.55 + 0.4\n                });\n            }\n\n            const startTime = performance.now();\n\n            // ==================== ƺ ====================\n\n            function drawSky(time) {\n                const skyGrad = ctx.createLinearGradient(0, 0, 0, 340);\n                skyGrad.addColorStop(0, '#060615');\n                skyGrad.addColorStop(0.4, '#0d0d28');\n                skyGrad.addColorStop(0.75, '#141435');\n                skyGrad.addColorStop(1, '#1a1a3d');\n                ctx.fillStyle = skyGrad;\n                ctx.fillRect(0, 0, W, 340);\n            }\n\n            function drawStars(time) {\n                for (const star of stars) {\n                    const twinkle = 0.55 + 0.45 * Math.sin(time * star.speed + star.phase);\n                    const alpha = star.baseAlpha * twinkle;\n                    ctx.fillStyle = `rgba(255, 250, 235, ${alpha.toFixed(3)})`;\n                    ctx.beginPath();\n                    ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n                // ż\n                if (Math.random() < 0.03) {\n                    const sx = Math.random() * W;\n                    const sy = Math.random() * 200;\n                    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n                    ctx.beginPath();\n                    ctx.arc(sx, sy, 0.8, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n            }\n\n            function drawHorizon(time) {\n                // Զɽ/ƽ\n                ctx.fillStyle = '#101025';\n                ctx.beginPath();\n                ctx.moveTo(0, 335);\n                for (let x = 0; x <= W; x += 30) {\n                    const y = 322 + Math.sin(x * 0.004 + 1.2) * 9 + Math.sin(x * 0.011 + 0.5) * 6;\n                    ctx.lineTo(x, y);\n                }\n                ctx.lineTo(W, 350);\n                ctx.lineTo(0, 350);\n                ctx.closePath();\n                ctx.fill();\n\n                // ڶɽ\n                ctx.fillStyle = '#151530';\n                ctx.beginPath();\n                ctx.moveTo(0, 328);\n                for (let x = 0; x <= W; x += 25) {\n                    const y = 318 + Math.sin(x * 0.006 + 2.5) * 7 + Math.sin(x * 0.014 + 1.8) * 5;\n                    ctx.lineTo(x, y);\n                }\n                ctx.lineTo(W, 342);\n                ctx.lineTo(0, 342);\n                ctx.closePath();\n                ctx.fill();\n            }\n\n            function drawSea(time) {\n                const seaGrad = ctx.createLinearGradient(0, 335, 0, 520);\n                seaGrad.addColorStop(0, '#0a1628');\n                seaGrad.addColorStop(0.3, '#0d1e35');\n                seaGrad.addColorStop(0.7, '#0f2542');\n                seaGrad.addColorStop(1, '#142a45');\n                ctx.fillStyle = seaGrad;\n                ctx.fillRect(0, 335, W, 185);\n\n                // \n                ctx.strokeStyle = 'rgba(180,200,220,0.05)';\n                ctx.lineWidth = 1;\n                for (let i = 0; i < 14; i++) {\n                    const baseY = 342 + i * 13;\n                    ctx.beginPath();\n                    for (let x = 0; x < W; x += 8) {\n                        const y = baseY + Math.sin(time * 1.3 + x * 0.018 + i * 0.6) * 4.5;\n                        if (x === 0) ctx.moveTo(x, y);\n                        else ctx.lineTo(x, y);\n                    }\n                    ctx.stroke();\n                }\n\n                // ·Ƶӳ\n                const reflGrad = ctx.createLinearGradient(0, 345, 0, 490);\n                reflGrad.addColorStop(0, 'rgba(255,200,120,0.07)');\n                reflGrad.addColorStop(0.5, 'rgba(255,180,100,0.03)');\n                reflGrad.addColorStop(1, 'rgba(255,150,80,0)');\n                ctx.fillStyle = reflGrad;\n                ctx.beginPath();\n                const reflCX = 850;\n                ctx.moveTo(reflCX - 70, 345);\n                ctx.quadraticCurveTo(reflCX, 430, reflCX - 25, 490);\n                ctx.lineTo(reflCX + 25, 490);\n                ctx.quadraticCurveTo(reflCX, 430, reflCX + 70, 345);\n                ctx.fill();\n            }\n\n            function drawShore(time) {\n                const shoreGrad = ctx.createLinearGradient(0, 505, 0, 555);\n                shoreGrad.addColorStop(0, '#283040');\n                shoreGrad.addColorStop(0.4, '#353835');\n                shoreGrad.addColorStop(1, '#424238');\n                ctx.fillStyle = shoreGrad;\n                ctx.fillRect(0, 505, W, 50);\n            }\n\n            function drawRoad(time) {\n                // ·\n                const roadGrad = ctx.createLinearGradient(0, 548, 0, 700);\n                roadGrad.addColorStop(0, '#3d3d3d');\n                roadGrad.addColorStop(0.15, '#383838');\n                roadGrad.addColorStop(1, '#2a2a2a');\n                ctx.fillStyle = roadGrad;\n                ctx.fillRect(0, 548, W, 152);\n\n                // ·\n                ctx.fillStyle = '#4e4e4e';\n                ctx.fillRect(0, 546, W, 5);\n                ctx.fillStyle = '#5c5c5c';\n                ctx.fillRect(0, 695, W, 5);\n\n                // ·\n                ctx.strokeStyle = '#d0d0d0';\n                ctx.lineWidth = 3;\n                ctx.setLineDash([32, 22]);\n                ctx.lineCap = 'round';\n                ctx.beginPath();\n                ctx.moveTo(0, 621);\n                ctx.lineTo(W, 621);\n                ctx.stroke();\n                ctx.setLineDash([]);\n                ctx.lineCap = 'butt';\n            }\n\n            function drawLampPost(x, baseY, time) {\n                const baseX = x;\n                const poleBottom = baseY;\n                const poleTop = baseY - 260;\n\n                // \n                ctx.fillStyle = '#3d3d3d';\n                ctx.beginPath();\n                ctx.roundRect(baseX - 13, poleBottom - 9, 26, 10, 3);\n                ctx.fill();\n                ctx.fillStyle = '#505050';\n                ctx.beginPath();\n                ctx.roundRect(baseX - 11, poleBottom - 11, 22, 4, 2);\n                ctx.fill();\n\n                // Ƹ\n                ctx.strokeStyle = '#5e5e5e';\n                ctx.lineWidth = 7;\n                ctx.lineCap = 'round';\n                ctx.beginPath();\n                ctx.moveTo(baseX, poleBottom);\n                ctx.lineTo(baseX, poleTop);\n                ctx.stroke();\n\n                // Ƹ˼ӹ̻\n                ctx.strokeStyle = '#6e6e6e';\n                ctx.lineWidth = 2.5;\n                ctx.beginPath();\n                ctx.moveTo(baseX - 4, poleBottom - 25);\n                ctx.lineTo(baseX + 4, poleBottom - 25);\n                ctx.stroke();\n                ctx.beginPath();\n                ctx.moveTo(baseX - 3, poleBottom - 50);\n                ctx.lineTo(baseX + 3, poleBottom - 50);\n                ctx.stroke();\n\n                // Ʊ\n                const armStartY = poleTop + 25;\n                const armEndX = baseX - 65;\n                const armEndY = poleTop - 8;\n                ctx.strokeStyle = '#5a5a5a';\n                ctx.lineWidth = 5;\n                ctx.beginPath();\n                ctx.moveTo(baseX, armStartY);\n                ctx.quadraticCurveTo(baseX - 25, armStartY - 15, armEndX, armEndY);\n                ctx.stroke();\n\n                // ƾ\n                const lampX = armEndX;\n                const lampY = armEndY;\n                ctx.fillStyle = '#3a3a3a';\n                ctx.beginPath();\n                ctx.moveTo(lampX - 16, lampY);\n                ctx.lineTo(lampX + 16, lampY);\n                ctx.lineTo(lampX + 11, lampY + 18);\n                ctx.lineTo(lampX - 11, lampY + 18);\n                ctx.closePath();\n                ctx.fill();\n                ctx.strokeStyle = '#555';\n                ctx.lineWidth = 1.5;\n                ctx.stroke();\n\n                // ƹâ（）\n                const glowGrad1 = ctx.createRadialGradient(lampX, lampY + 10, 8, lampX, lampY + 10, 160);\n                glowGrad1.addColorStop(0, 'rgba(255,245,210,0.55)');\n                glowGrad1.addColorStop(0.2, 'rgba(255,225,160,0.3)');\n                glowGrad1.addColorStop(0.5, 'rgba(255,190,110,0.08)');\n                glowGrad1.addColorStop(1, 'rgba(255,160,60,0)');\n                ctx.fillStyle = glowGrad1;\n                ctx.beginPath();\n                ctx.arc(lampX, lampY + 10, 160, 0, Math.PI * 2);\n                ctx.fill();\n\n                // ƹĸǿ\n                const glowGrad2 = ctx.createRadialGradient(lampX, lampY + 10, 0, lampX, lampY + 10, 35);\n                glowGrad2.addColorStop(0, 'rgba(255,255,240,0.75)');\n                glowGrad2.addColorStop(0.4, 'rgba(255,245,210,0.35)');\n                glowGrad2.addColorStop(1, 'rgba(255,210,120,0)');\n                ctx.fillStyle = glowGrad2;\n                ctx.beginPath();\n                ctx.arc(lampX, lampY + 10, 35, 0, Math.PI * 2);\n                ctx.fill();\n\n                // ϵĹ\n                ctx.save();\n                ctx.globalAlpha = 0.22;\n                const groundGlow = ctx.createRadialGradient(lampX, baseY, 8, lampX, baseY, 110);\n                groundGlow.addColorStop(0, 'rgba(255,225,160,0.7)');\n                groundGlow.addColorStop(0.4, 'rgba(255,190,110,0.25)');\n                groundGlow.addColorStop(1, 'rgba(255,150,50,0)');\n                ctx.fillStyle = groundGlow;\n                ctx.beginPath();\n                ctx.ellipse(lampX, baseY, 110, 28, 0, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.restore();\n\n                return { lampX, lampY: lampY + 10, baseY, baseX };\n            }\n\n            function drawCar(x, y, time) {\n                const carW = 55;\n                const carH = 24;\n                ctx.save();\n                ctx.translate(x, y);\n\n                // Ӱ\n                ctx.fillStyle = 'rgba(0,0,0,0.45)';\n                ctx.beginPath();\n                ctx.ellipse(0, 9, carW / 2 + 6, 7, 0, 0, Math.PI * 2);\n                ctx.fill();\n\n                // \n                const bodyGrad = ctx.createLinearGradient(0, -carH, 0, 0);\n                bodyGrad.addColorStop(0, '#3a4a5a');\n                bodyGrad.addColorStop(1, '#1a2a3a');\n                ctx.fillStyle = bodyGrad;\n                ctx.beginPath();\n                ctx.roundRect(-carW / 2, -carH, carW, carH, 6);\n                ctx.fill();\n                ctx.strokeStyle = '#4a5a6a';\n                ctx.lineWidth = 1;\n                ctx.stroke();\n\n                // \n                ctx.fillStyle = '#1e2e3e';\n                ctx.beginPath();\n                ctx.roundRect(-carW / 2 + 10, -carH - 9, carW - 20, 11, 5);\n                ctx.fill();\n\n                // \n                ctx.fillStyle = 'rgba(160,190,210,0.55)';\n                ctx.beginPath();\n                ctx.roundRect(-carW / 2 + 13, -carH - 7, carW / 2 - 8, 7, 3);\n                ctx.fill();\n                ctx.beginPath();\n                ctx.roundRect(carW / 2 - carW / 2 - 5, -carH - 7, carW / 2 - 10, 7, 3);\n                ctx.fill();\n\n                // ǰƣɫ\n                ctx.fillStyle = 'rgba(255,255,210,0.85)';\n                ctx.beginPath();\n                ctx.arc(carW / 2 - 6, -carH / 2, 4, 0, Math.PI * 2);\n                ctx.fill();\n                // βƣɫ\n                ctx.fillStyle = 'rgba(255,80,40,0.85)';\n                ctx.beginPath();\n                ctx.arc(-carW / 2 + 6, -carH / 2, 4, 0, Math.PI * 2);\n                ctx.fill();\n\n                // ǰƹ\n                ctx.fillStyle = 'rgba(255,250,210,0.18)';\n                ctx.beginPath();\n                ctx.moveTo(carW / 2, -carH / 2);\n                ctx.lineTo(carW / 2 + 45, -carH / 2 - 14);\n                ctx.lineTo(carW / 2 + 45, -carH / 2 + 14);\n                ctx.closePath();\n                ctx.fill();\n\n                // \n                ctx.fillStyle = '#111';\n                ctx.beginPath();\n                ctx.arc(-carW / 3.2, carH / 2 - 1, 9, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.beginPath();\n                ctx.arc(carW / 3.2, carH / 2 - 1, 9, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.fillStyle = '#3a3a3a';\n                ctx.beginPath();\n                ctx.arc(-carW / 3.2, carH / 2 - 1, 4.5, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.beginPath();\n                ctx.arc(carW / 3.2, carH / 2 - 1, 4.5, 0, Math.PI * 2);\n                ctx.fill();\n\n                ctx.restore();\n            }\n\n            function drawBicycle(bikeX, bikeY, time) {\n                const pedalAngle = time * 12.5;\n                const wheelAngle = time * 8.2;\n\n                const frontWheelCX = bikeX - 88;\n                const frontWheelCY = bikeY - 36;\n                const rearWheelCX = bikeX + 88;\n                const rearWheelCY = bikeY - 36;\n                const wheelR = 36;\n\n                const headTubeTopX = bikeX - 118;\n                const headTubeTopY = bikeY - 76;\n                const headTubeBottomX = bikeX - 108;\n                const headTubeBottomY = bikeY - 50;\n\n                const seatTubeTopX = bikeX + 38;\n                const seatTubeTopY = bikeY - 68;\n                const seatTubeBottomX = bikeX + 28;\n                const seatTubeBottomY = bikeY - 4;\n\n                const crankCenterX = seatTubeBottomX;\n                const crankCenterY = seatTubeBottomY;\n                const crankR = 13;\n                const crankArmLen = 21;\n\n                const leftPedalAngle = pedalAngle;\n                const rightPedalAngle = pedalAngle + Math.PI;\n                const leftPedalX = crankCenterX + crankArmLen * Math.cos(leftPedalAngle);\n                const leftPedalY = crankCenterY + crankArmLen * Math.sin(leftPedalAngle);\n                const rightPedalX = crankCenterX + crankArmLen * Math.cos(rightPedalAngle);\n                const rightPedalY = crankCenterY + crankArmLen * Math.sin(rightPedalAngle);\n\n                // Ƴ\n                function drawWheel(cx, cy, r, angle) {\n                    // ̥\n                    ctx.strokeStyle = '#1a1a1a';\n                    ctx.lineWidth = 7;\n                    ctx.beginPath();\n                    ctx.arc(cx, cy, r, 0, Math.PI * 2);\n                    ctx.stroke();\n\n                    // Ȧ\n                    ctx.strokeStyle = '#b8b8b8';\n                    ctx.lineWidth = 2.5;\n                    ctx.beginPath();\n                    ctx.arc(cx, cy, r - 4.5, 0, Math.PI * 2);\n                    ctx.stroke();\n\n                    // \n                    ctx.fillStyle = '#909090';\n                    ctx.beginPath();\n                    ctx.arc(cx, cy, 5.5, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.fillStyle = '#ccc';\n                    ctx.beginPath();\n                    ctx.arc(cx, cy, 2.8, 0, Math.PI * 2);\n                    ctx.fill();\n\n                    // ˿\n                    const spokeCount = 20;\n                    ctx.strokeStyle = '#a0a0a0';\n                    ctx.lineWidth = 0.7;\n                    for (let i = 0; i < spokeCount; i++) {\n                        const a = angle + (i / spokeCount) * Math.PI * 2;\n                        const innerR = 5.5;\n                        const outerR = r - 5.5;\n                        ctx.beginPath();\n                        ctx.moveTo(cx + innerR * Math.cos(a), cy + innerR * Math.sin(a));\n                        ctx.lineTo(cx + outerR * Math.cos(a), cy + outerR * Math.sin(a));\n                        ctx.stroke();\n                    }\n                }\n\n                drawWheel(frontWheelCX, frontWheelCY, wheelR, wheelAngle);\n                drawWheel(rearWheelCX, rearWheelCY, wheelR, wheelAngle);\n\n                // Ǽ\n                ctx.lineCap = 'round';\n                ctx.lineJoin = 'round';\n\n                // ¹ (down tube)\n                ctx.strokeStyle = '#c0392b';\n                ctx.lineWidth = 7;\n                ctx.beginPath();\n                ctx.moveTo(headTubeBottomX, headTubeBottomY);\n                ctx.lineTo(seatTubeBottomX, seatTubeBottomY);\n                ctx.stroke();\n\n                // Ϲ (top tube)\n                ctx.strokeStyle = '#d4453a';\n                ctx.lineWidth = 6;\n                ctx.beginPath();\n                ctx.moveTo(headTubeTopX, headTubeTopY);\n                ctx.lineTo(seatTubeTopX, seatTubeTopY);\n                ctx.stroke();\n\n                //  (seat tube)\n                ctx.strokeStyle = '#b8352e';\n                ctx.lineWidth = 6;\n                ctx.beginPath();\n                ctx.moveTo(seatTubeTopX, seatTubeTopY);\n                ctx.lineTo(seatTubeBottomX, seatTubeBottomY);\n                ctx.stroke();\n\n                // ² (chain stay)\n                ctx.strokeStyle = '#a8322a';\n                ctx.lineWidth = 5;\n                ctx.beginPath();\n                ctx.moveTo(seatTubeBottomX, seatTubeBottomY);\n                ctx.lineTo(rearWheelCX, rearWheelCY);\n                ctx.stroke();\n\n                // ϲ (seat stay)\n                ctx.strokeStyle = '#b8352e';\n                ctx.lineWidth = 5;\n                ctx.beginPath();\n                ctx.moveTo(seatTubeTopX, seatTubeTopY);\n                ctx.lineTo(rearWheelCX, rearWheelCY);\n                ctx.stroke();\n\n                // ǰ (fork)\n                ctx.strokeStyle = '#8a8a8a';\n                ctx.lineWidth = 6;\n                ctx.beginPath();\n                ctx.moveTo(headTubeBottomX, headTubeBottomY);\n                ctx.lineTo(frontWheelCX, frontWheelCY);\n                ctx.stroke();\n\n                // ǰ泵\n                ctx.strokeStyle = '#7a7a7a';\n                ctx.lineWidth = 8;\n                ctx.beginPath();\n                ctx.moveTo(headTubeTopX, headTubeTopY);\n                ctx.lineTo(headTubeBottomX, headTubeBottomY);\n                ctx.stroke();\n\n                // \n                ctx.strokeStyle = '#555';\n                ctx.lineWidth = 5;\n                const hbarCX = headTubeTopX;\n                const hbarCY = headTubeTopY - 5;\n                ctx.beginPath();\n                ctx.arc(hbarCX, hbarCY, 13, -Math.PI * 0.75, Math.PI * 0.25);\n                ctx.stroke();\n                // ֱ\n                ctx.fillStyle = '#333';\n                ctx.beginPath();\n                ctx.arc(hbarCX - 10, hbarCY + 8, 5, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.beginPath();\n                ctx.arc(hbarCX + 8, hbarCY + 6, 5, 0, Math.PI * 2);\n                ctx.fill();\n\n                // ѹ\n                ctx.strokeStyle = '#6a6a6a';\n                ctx.lineWidth = 4;\n                ctx.beginPath();\n                ctx.moveTo(seatTubeTopX, seatTubeTopY - 4);\n                ctx.lineTo(seatTubeTopX, seatTubeTopY - 20);\n                ctx.stroke();\n\n                // \n                const seatY = seatTubeTopY - 22;\n                ctx.fillStyle = '#5d3818';\n                ctx.beginPath();\n                ctx.ellipse(seatTubeTopX, seatY, 17, 7, 0, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.strokeStyle = '#3a1e08';\n                ctx.lineWidth = 1.5;\n                ctx.stroke();\n                // Ѹ߹\n                ctx.fillStyle = '#7a4a25';\n                ctx.beginPath();\n                ctx.ellipse(seatTubeTopX, seatY - 2, 14, 4, 0, 0, Math.PI * 2);\n                ctx.fill();\n\n                //  (chainring)\n                const chainringGrad = ctx.createRadialGradient(crankCenterX, crankCenterY, 3, crankCenterX, crankCenterY,\n                    crankR);\n                chainringGrad.addColorStop(0, '#555');\n                chainringGrad.addColorStop(1, '#2a2a2a');\n                ctx.fillStyle = chainringGrad;\n                ctx.beginPath();\n                ctx.arc(crankCenterX, crankCenterY, crankR, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.strokeStyle = '#666';\n                ctx.lineWidth = 2;\n                ctx.beginPath();\n                ctx.arc(crankCenterX, crankCenterY, crankR, 0, Math.PI * 2);\n                ctx.stroke();\n                // \n                ctx.fillStyle = '#444';\n                ctx.beginPath();\n                ctx.arc(crankCenterX, crankCenterY, 4.5, 0, Math.PI * 2);\n                ctx.fill();\n\n                //  (chain)\n                ctx.strokeStyle = '#5a5a5a';\n                ctx.lineWidth = 1.8;\n                ctx.setLineDash([4, 3]);\n                const rearGearR = 7;\n                ctx.beginPath();\n                ctx.moveTo(crankCenterX + crankR, crankCenterY);\n                ctx.lineTo(rearWheelCX + rearGearR, rearWheelCY);\n                ctx.stroke();\n                ctx.beginPath();\n                ctx.moveTo(crankCenterX - crankR, crankCenterY);\n                ctx.lineTo(rearWheelCX - rearGearR, rearWheelCY);\n                ctx.stroke();\n                // \n                ctx.beginPath();\n                ctx.moveTo(crankCenterX, crankCenterY + crankR);\n                ctx.lineTo(rearWheelCX, rearWheelCY + rearGearR);\n                ctx.stroke();\n                ctx.setLineDash([]);\n\n                // ̤˺ͽ̤\n                function drawCrankArm(sx, sy, ex, ey) {\n                    ctx.strokeStyle = '#6e6e6e';\n                    ctx.lineWidth = 5.5;\n                    ctx.lineCap = 'round';\n                    ctx.beginPath();\n                    ctx.moveTo(sx, sy);\n                    ctx.lineTo(ex, ey);\n                    ctx.stroke();\n                    // ǿ\n                    ctx.strokeStyle = '#7a7a7a';\n                    ctx.lineWidth = 2;\n                    ctx.beginPath();\n                    ctx.moveTo(sx, sy);\n                    ctx.lineTo(ex, ey);\n                    ctx.stroke();\n                }\n\n                function drawPedal(px, py) {\n                    ctx.fillStyle = '#4a4a4a';\n                    ctx.fillRect(px - 11, py - 3.5, 22, 7);\n                    ctx.strokeStyle = '#333';\n                    ctx.lineWidth = 1.2;\n                    ctx.strokeRect(px - 11, py - 3.5, 22, 7);\n                    // \n                    ctx.fillStyle = '#555';\n                    ctx.fillRect(px - 8, py - 2, 16, 3);\n                }\n\n                drawCrankArm(crankCenterX, crankCenterY, leftPedalX, leftPedalY);\n                drawPedal(leftPedalX, leftPedalY);\n                drawCrankArm(crankCenterX, crankCenterY, rightPedalX, rightPedalY);\n                drawPedal(rightPedalX, rightPedalY);\n\n                return {\n                    seatX: seatTubeTopX,\n                    seatY: seatY,\n                    handleX: hbarCX,\n                    handleY: hbarCY,\n                    leftPedalX,\n                    leftPedalY,\n                    rightPedalX,\n                    rightPedalY,\n                    headTubeTopX,\n                    headTubeTopY\n                };\n            }\n\n            function calculateKnee(hipX, hipY, ankleX, ankleY, thighLen, shinLen, direction) {\n                const dx = ankleX - hipX;\n                const dy = ankleY - hipY;\n                const d = Math.sqrt(dx * dx + dy * dy);\n                const midX = (hipX + ankleX) / 2;\n                const midY = (hipY + ankleY) / 2;\n                const halfD = d / 2;\n                let offset = Math.sqrt(Math.max(thighLen * thighLen - halfD * halfD, 0));\n                if (d > thighLen + shinLen) offset = 0;\n                if (d < 0.001) return { x: midX, y: midY };\n                const perpX = -dy / d * offset * direction;\n                const perpY = dx / d * offset * direction;\n                return { x: midX + perpX, y: midY + perpY };\n            }\n\n            function drawRider(seatX, seatY, handleX, handleY, leftPX, leftPY, rightPX, rightPY, time) {\n                const hipX = seatX + 6;\n                const hipY = seatY - 6;\n\n                // ͷ\n                const headCX = hipX + 6;\n                const headCY = hipY - 48;\n\n                // ͷ\n                const skinGrad = ctx.createRadialGradient(headCX - 2, headCY - 2, 2, headCX, headCY, 15);\n                skinGrad.addColorStop(0, '#ffe0c0');\n                skinGrad.addColorStop(0.7, '#e8b890');\n                skinGrad.addColorStop(1, '#c89570');\n                ctx.fillStyle = skinGrad;\n                ctx.beginPath();\n                ctx.arc(headCX, headCY, 14, 0, Math.PI * 2);\n                ctx.fill();\n                ctx.strokeStyle = '#b88060';\n                ctx.lineWidth = 1;\n                ctx.stroke();\n\n                // ͷ\n                ctx.fillStyle = '#1e2e3e';\n                ctx.beginPath();\n                ctx.arc(headCX, headCY - 9, 16, Math.PI, Math.PI * 2);\n                ctx.fill();\n                ctx.fillRect(headCX - 16, headCY - 9, 32, 6);\n                // ñ\n                ctx.fillStyle = '#2a3a4a';\n                ctx.beginPath();\n                ctx.arc(headCX, headCY - 11, 17, Math.PI * 0.15, Math.PI * 0.85);\n                ctx.fill();\n\n                // \n                const bodyGrad = ctx.createLinearGradient(hipX, hipY - 35, hipX, hipY);\n                bodyGrad.addColorStop(0, '#3a4a5a');\n                bodyGrad.addColorStop(1, '#2a3a4a');\n                ctx.strokeStyle = bodyGrad;\n                ctx.lineWidth = 11;\n                ctx.lineCap = 'round';\n                ctx.beginPath();\n                ctx.moveTo(hipX + 3, hipY);\n                ctx.lineTo(hipX + 8, hipY - 32);\n                ctx.stroke();\n\n                // ֱ - ϱ\n                ctx.strokeStyle = '#3e4e5e';\n                ctx.lineWidth = 6.5;\n                ctx.lineCap = 'round';\n                ctx.beginPath();\n                ctx.moveTo(hipX + 6, hipY - 27);\n                ctx.lineTo(handleX + 2, handleY + 8);\n                ctx.stroke();\n                // ǰ\n                ctx.strokeStyle = '#4a5a6a';\n                ctx.lineWidth = 5.5;\n                ctx.beginPath();\n                ctx.moveTo(handleX + 2, handleY + 8);\n                ctx.lineTo(handleX - 10, handleY + 16);\n                ctx.stroke();\n                // \n                ctx.fillStyle = '#e8b890';\n                ctx.beginPath();\n                ctx.arc(handleX - 10, handleY + 16, 4.5, 0, Math.PI * 2);\n                ctx.fill();\n\n                // Ȳ\n                function drawLeg(hx, hy, px, py, side) {\n                    const knee = calculateKnee(hx, hy, px, py, 33, 33, side);\n\n                    // \n                    ctx.strokeStyle = '#334455';\n                    ctx.lineWidth = 9.5;\n                    ctx.lineCap = 'round';\n                    ctx.beginPath();\n                    ctx.moveTo(hx, hy);\n                    ctx.lineTo(knee.x, knee.y);\n                    ctx.stroke();\n\n                    // С\n                    ctx.strokeStyle = '#3e5060';\n                    ctx.lineWidth = 7.5;\n                    ctx.beginPath();\n                    ctx.moveTo(knee.x, knee.y);\n                    ctx.lineTo(px, py);\n                    ctx.stroke();\n\n                    // ϥ\n                    ctx.fillStyle = '#3a4a5a';\n                    ctx.beginPath();\n                    ctx.arc(knee.x, knee.y, 5.5, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.strokeStyle = '#2a3a4a';\n                    ctx.lineWidth = 1;\n                    ctx.stroke();\n\n                    // Ь\n                    ctx.fillStyle = '#1a1a1a';\n                    ctx.save();\n                    ctx.translate(px, py);\n                    ctx.beginPath();\n                    ctx.ellipse(0, 2, 9, 5, 0.05, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.strokeStyle = '#333';\n                    ctx.lineWidth = 1;\n                    ctx.stroke();\n                    // Ьϸ\n                    ctx.fillStyle = '#2a2a2a';\n                    ctx.beginPath();\n                    ctx.arc(0, -1, 3, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.restore();\n                }\n\n                // ȣleftPedal = ࣩ\n                drawLeg(hipX, hipY, leftPX, leftPY, 1);\n                // ԶȣrightPedal = Զࣩ\n                drawLeg(hipX, hipY, rightPX, rightPY, -1);\n            }\n\n            function drawBushes(time) {\n                const bushData = [\n                    { x: 140, y: 543, s: 1.0 },\n                    { x: 310, y: 540, s: 1.2 },\n                    { x: 920, y: 542, s: 0.9 },\n                    { x: 1060, y: 544, s: 1.1 },\n                    { x: 70, y: 546, s: 0.8 },\n                    { x: 1140, y: 543, s: 1.0 },\n                    { x: 480, y: 541, s: 0.7 },\n                    { x: 750, y: 544, s: 0.85 },\n                ];\n\n                for (const b of bushData) {\n                    const s = b.s;\n                    ctx.fillStyle = '#1a3520';\n                    ctx.beginPath();\n                    ctx.arc(b.x, b.y, 13 * s, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.beginPath();\n                    ctx.arc(b.x - 9 * s, b.y + 3 * s, 10 * s, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.beginPath();\n                    ctx.arc(b.x + 9 * s, b.y + 3 * s, 10 * s, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.fillStyle = '#254530';\n                    ctx.beginPath();\n                    ctx.arc(b.x, b.y - 4 * s, 9 * s, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.fillStyle = '#305a38';\n                    ctx.beginPath();\n                    ctx.arc(b.x + 2 * s, b.y - 5 * s, 5 * s, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n            }\n\n            // ==================== ѭ ====================\n            function animate(timestamp) {\n                const time = (timestamp - startTime) / 1000;\n\n                ctx.setTransform(1, 0, 0, 1, 0, 0);\n                ctx.clearRect(0, 0, canvas.width, canvas.height);\n                ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);\n\n                // ƾӺǰ\n                drawSky(time);\n                drawStars(time);\n                drawHorizon(time);\n                drawSea(time);\n                drawShore(time);\n                drawRoad(time);\n                drawBushes(time);\n\n                // Զ·\n                drawLampPost(180, 546, time);\n                drawLampPost(380, 546, time);\n\n                // ·\n                const carSpeed = 75;\n                const carX = ((time * carSpeed) % (W + 350)) - 175;\n                drawCar(carX, 618, time);\n                // ڶ·\n                const car2X = ((time * carSpeed * 0.7 + 600) % (W + 350)) - 175;\n                drawCar(car2X, 616, time);\n\n                // ·\n                drawLampPost(850, 546, time);\n                drawLampPost(1080, 546, time);\n\n                // гӰ\n                const bikeX = 590;\n                const bikeY = 600;\n                ctx.fillStyle = 'rgba(0,0,0,0.4)';\n                ctx.beginPath();\n                ctx.ellipse(bikeX, bikeY + 6, 105, 9, 0, 0, Math.PI * 2);\n                ctx.fill();\n\n                // ƳǼܺͳ\n                const bikeParts = drawBicycle(bikeX, bikeY, time);\n\n                // Ƴ\n                drawRider(\n                    bikeParts.seatX, bikeParts.seatY,\n                    bikeParts.handleX, bikeParts.handleY,\n                    bikeParts.leftPedalX, bikeParts.leftPedalY,\n                    bikeParts.rightPedalX, bikeParts.rightPedalY,\n                    time\n                );\n\n                // ǰ·ʯͷ\